# Copy to .env and adjust for your machine.

# --- Local Postgres -------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/iyambere

# --- Hosted Postgres (Aiven, Neon, Supabase, ...) -------------------------
# Take the URI from the provider's console and keep ?sslmode=require on the end.
# DATABASE_URL=postgres://avnadmin:YOUR_PASSWORD@YOUR_HOST.aivencloud.com:PORT/defaultdb?sslmode=require
#
# Path to the CA certificate downloaded from the same console. Without it the
# connection is encrypted but the server's identity is not verified.
# PGSSLROOTCERT=./certs/ca.pem

JWT_SECRET=change-me-before-any-real-deployment
PORT=4000
